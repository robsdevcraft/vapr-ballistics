# =============================================================================
# WIP BOILERPLATE — NOT FUNCTIONAL. DO NOT USE YET.
#
# Placeholder dev image. Assumes npm, but the repo uses pnpm and is migrating to
# TanStack Start (see docs/plan.md). A real container lands in Phase 7
# (docs/specs/0008-deploy-docker.md). Use `pnpm --filter @vapr/js-client dev`
# for local development instead.
# =============================================================================

FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source code
COPY . .

EXPOSE 3000

# Development command
CMD ["npm", "run", "dev"]
