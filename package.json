{
  "name": "vapr-ballistics",
  "version": "1.0.0-monorepo",
  "private": true,
  "description": "Monorepo for VAPR Ballistics Calculator - FastAPI fullstack and client-only variants",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "dev:client": "pnpm --filter @vapr/js-client dev",
    "build:client": "pnpm --filter @vapr/js-client build",
    "lint:client": "pnpm --filter @vapr/js-client lint",
    "typecheck:client": "pnpm --filter @vapr/js-client typecheck",
    "test:client": "pnpm --filter @vapr/js-client test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@eslint/config-array@0.21.1>minimatch": "3.1.5",
      "@eslint/eslintrc@3.3.1>ajv": "6.14.0",
      "@eslint/eslintrc@3.3.1>minimatch": "3.1.5",
      "@tailwindcss/postcss@4.1.16>postcss": "8.5.10",
      "ajv": "6.14.0",
      "brace-expansion": "1.1.14",
      "flat-cache@4.0.1>flatted": "3.4.2",
      "flatted": "3.4.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "minimatch": "3.1.5",
      "next@16.2.6>postcss": "8.5.10",
      "postcss": "8.5.10"
    }
  }
}
