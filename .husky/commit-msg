# Validate commit message format using commitlint

# Find Node.js and add to PATH if not already available
which node > /dev/null 2>&1 && NODE_FOUND="yes" || NODE_FOUND="no"

# Check node_modules/.bin first (husky already adds it to PATH)
if [ "$NODE_FOUND" = "no" ] && { [ -f "node_modules/.bin/node" ] || [ -f "node_modules/.bin/node.exe" ]; }; then
  # node_modules/.bin is already in PATH from husky, so node should be available
  if which node > /dev/null 2>&1; then
    NODE_FOUND="yes"
  fi
fi

if [ "$NODE_FOUND" = "no" ]; then
  # Get Windows username (works in Git Bash)
  WIN_USER=$(whoami 2>/dev/null || echo "$USERNAME" || echo "$USER")
  
  # Check common Node.js installation locations on Windows (handle paths with spaces)
  for NODE_DIR in "/c/Program Files/nodejs" "/c/Program Files (x86)/nodejs" "/c/Program Files/FW Packages" "/c/Users/$WIN_USER/AppData/Local/Programs/nodejs"; do
    if [ -f "$NODE_DIR/node.exe" ] || [ -f "$NODE_DIR/node" ]; then
      export PATH="$NODE_DIR:$PATH"
      break
    fi
  done
  
  # If still not found, try using pnpm exec (pnpm should have Node.js)
  if ! which node > /dev/null 2>&1; then
    if command -v pnpm > /dev/null 2>&1; then
      pnpm exec commitlint --edit "$1"
      exit $?
    fi
  fi
fi

npx --no -- commitlint --edit "$1"
